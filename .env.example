# ==============================================================
#  MortgagePro Global — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  .env.local is git-ignored and NEVER committed.
# ==============================================================

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="MortgagePro Global"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"   # development | staging | production

# ── SEO / Analytics ───────────────────────────────────────────
# Google Analytics 4 Measurement ID (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console verification meta tag content (optional)
NEXT_PUBLIC_GSC_VERIFICATION=""

# ── Rate Data (optional future integration) ───────────────────
# If you later integrate a live mortgage-rate API, add its key here.
# Prefix with NEXT_PUBLIC_ only if the key is safe to expose to the browser.
MORTGAGE_RATE_API_KEY="rk_9dc011372969201aa212e5b0ee1ba2839391dd8030a04867b20e83fe3f258917"
# MORTGAGE_RATE_API_URL="https://api.example.com/v1/rates"

# ── Feature Flags ─────────────────────────────────────────────
# Set to "true" to enable experimental features
NEXT_PUBLIC_ENABLE_RATE_ALERTS="false"
NEXT_PUBLIC_ENABLE_COMPARE_MODE="false"

# ── Vercel / Deployment (auto-set by Vercel, set manually for other hosts) ──
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# NEXT_PUBLIC_APP_ENV="production"
